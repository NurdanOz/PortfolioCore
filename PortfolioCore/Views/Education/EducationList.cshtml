@model List<PortfolioCore.Entities.Education>

@{
    ViewData["Title"] = "EducationList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<h1>Eğitim Listesi</h1>

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Okul</th>
        <th>Hangi Tarihlerde Okudun ?</th>
        <th>Hangi Bölümde Okudun?</th>
        <th>Açıklama</th>
        <th>Sil</th>
        <th>Güncelle</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.EducationID</td>
            <td>@item.Title</td>
            <td>@item.DateInfo</td>
            <td>@item.SubTitle</td>
            <td>@item.Description</td>
            <td><a href="/Education/DeleteEducation/@item.EducationID" class="btn btn-danger">Sil</a></td>
            <td><a href="/Education/UpdateEducation/@item.EducationID" class="btn btn-success">Güncelle</a></td>
        </tr>
    }

</table>
<a href="/Education/CreateEducation/" class="btn btn-primary">Yeni Eğitim Girişi</a>

