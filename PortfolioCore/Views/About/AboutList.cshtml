@model List<About>
@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h1>Hakkımda Sayfası</h1>


<table class="table table-bordered">
	<tr>
		<th>#</th>
		<th>Başlık</th>
		<th>Açıklama</th>
		<th>Alt Açıklama</th>
		<th>Yaş</th>
		<th>Telefon No</th>
		<th>Mail</th>
		<th>Fotoğraf Link</th>
		<th>Güncelle</th>
	</tr>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.AboutId</td>
			<td>@item.Title</td>
			<td>@item.Description</td>
			<td>@item.SubDescription</td>
			<td>@item.Age</td>
			<td>@item.PhoneNumber</td>
			<td>@item.Email</td>
			<td>@item.ImageUrl</td>
			
			<td><a href="/About/AboutUpdate/@item.AboutId" class="btn btn-success">Güncelle</a></td>
		</tr>
	}
</table>


