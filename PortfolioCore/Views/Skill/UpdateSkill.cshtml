@model Skill
@{
    ViewData["Title"] = "UpdateSkill";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h2>Yetenek Güncelleme Sayfası</h2>

<form method="post">
    <input type="hidden" asp-for="SkillID" />
    <label>Yetnek Başlığı</label>
    <input type="text" asp-for="SkillName" class="form-control" />
    <br />
    <label>Yetnek Değeri</label>
    <input type="number" asp-for="SkillValue" class="form-control" />
    <br />
    <button class="btn btn-success">Yeteneği Güncelle</button>
</form>

