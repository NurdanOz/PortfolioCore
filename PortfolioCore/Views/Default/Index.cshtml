@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body class="index-page">
@await Component.InvokeAsync("_DefaultSidebarComponentPartial")
       <main class="main">
        <!-- Hero Section -->
        @await Component.InvokeAsync("_DefaultFeatureComponentPartial")
       
        <!-- Hero Section -->

        <!-- About Section -->
        @await Component.InvokeAsync("_DefaultAboutComponentPartial")
        <!-- About Section -->

        <!-- Stats Section -->
        @await Component.InvokeAsync("_DefaultStatsComponentPartial")
        <!-- Stats Section -->

        <!-- Skills Section -->
        @await Component.InvokeAsync("_DefaultSkillComponentPartial")
        <!-- Skills Section -->

        <!-- Resume Section -->
        @await Component.InvokeAsync("_DefaultEducationComponentPartial")
        <!-- Resume Section -->

        <!-- Portfolio Section -->
        @await Component.InvokeAsync("_DefaultPortfolioComponentPartial")
       <!-- /Portfolio Section -->

        <!-- Services Section -->
        @await Component.InvokeAsync("_DefaultServiceComponentPartial")
        <!-- Services Section -->

        <!-- Testimonials Section -->
        @await Component.InvokeAsync("_DefaultTestimonialCompanentPartial")
        <!-- /Testimonials Section -->

        <!-- Contact Section -->
        @await Component.InvokeAsync("_DefaultContactComponentPartial")
        <!-- /Contact Section -->

    </main>

    <footer id="footer" class="footer position-relative light-background">
        <div class="container">
            <h3 class="sitename">Nurdan Özdemir</h3>
            <p>Sosyal Medya Hesapları</p>
            <div class="social-links d-flex justify-content-center">
                <a href=""><i class="bi bi-twitter-x"></i></a>
                <a href=""><i class="bi bi-facebook"></i></a>
                <a href=""><i class="bi bi-instagram"></i></a>
                <a href=""><i class="bi bi-linkedin"></i></a>
            </div>
            <div class="container">
                <div class="copyright">
                    <span>Telif Hakkı</span> <strong class="px-1 sitename">N.Ö</strong> <span> / Tüm Hakları Saklıdır.</span>
                </div>
                <div class="credits">
                    <!-- All the links in the footer should remain intact. -->
                    <!-- You can delete the links only if you've purchased the pro version. -->
                    <!-- Licensing information: https://bootstrapmade.com/license/ -->
                    <!-- Purchase the pro version with working PHP/AJAX contact form: [buy-url] -->
                    <a href="">Asp.Net Core</a> tarafından tasarlandı.
                </div>
            </div>
        </div>
    </footer>

    <!-- Scroll Top -->

    @await Component.InvokeAsync("_DefaultScriptComponentPartial")

</body>

</html>
